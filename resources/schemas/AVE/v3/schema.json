										"$ref": "#/$defs/controlNumber"
									},
									{
										"$ref": "#/$defs/localizedDescription"
									}
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "CONTROL_UTF8"
							}
						}
					},
					"then": {
						"properties": {
							"values": {
								"type": "array",
								"items": {
									"$ref": "../../common/2026.10.23/schema.json#/$defs/uint8"
