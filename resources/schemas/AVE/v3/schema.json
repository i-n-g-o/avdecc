				}
			},
			"required": [
				"type",
				"values"
			],
			"allOf": [
				{
					"if": {
						"properties": {
							"type": {
								"pattern": "^CONTROL_(LINEAR|ARRAY)_"
							}
						}
					},
					"then": {
						"properties": {
							"values": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/controlNumber"
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"pattern": "^CONTROL_SELECTOR_"
							}
						}
					},
					"then": {
						"properties": {
							"values": {
