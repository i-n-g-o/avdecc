{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "AEM Tree Schema",
	"description": "JSON validation schema for ATDECC Entity Model Tree (static model only)",
	"type": "object",
	"schema_version": "2026.10.23",
	"$defs": {
		"descriptorIndex": {
			"$ref": "../../common/2026.10.23/schema.json#/$defs/descriptorIndex"
		},
		"localizedDescription": {
			"$ref": "../../common/2026.10.23/schema.json#/$defs/localizedDescriptionOrNull"
		},
		"avdeccString": {
			"$ref": "../../common/2026.10.23/schema.json#/$defs/avdeccString"
		},
		"entityDescriptor": {
			"type": "object",
			"properties": {
				"configuration_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/configurationDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"static": {
					"$ref": "#/$defs/entityDescriptorStaticModel"
				}
			},
			"required": [
				"configuration_descriptors",
				"static"
			]
		},
		"entityDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"model_name_string": {
					"$ref": "#/$defs/localizedDescription"
				},
				"vendor_name_string": {
					"$ref": "#/$defs/localizedDescription"
				}
			},
			"required": [
				"model_name_string",
				"vendor_name_string"
			]
		},
		"configurationDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/configurationDescriptorStaticModel"
				},
				"audio_unit_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/audioUnitDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"stream_input_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/streamDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"stream_output_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/streamDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"jack_input_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/jackDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"jack_output_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/jackDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"avb_interface_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/avbInterfaceDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"clock_source_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/clockSourceDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"memory_object_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/memoryObjectDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"locale_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/localeDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"control_descriptors": {
					"$ref": "#/$defs/controlDescriptors"
				},
				"clock_domain_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/clockDomainDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"timing_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/timingDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"ptp_instance_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/ptpInstanceDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"static"
			]
		},
		"configurationDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"descriptor_counts": {
					"type": "array",
					"items": {
						"type": "array",
						"prefixItems": [
							{
								"$ref": "../../common/2026.10.23/schema.json#/$defs/descriptorType"
							},
							{
								"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
							}
						],
						"minItems": 2,
						"maxItems": 2
					}
				}
			},
			"required": []
		},
		"audioUnitDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/audioUnitDescriptorStaticModel"
				},
				"control_descriptors": {
					"$ref": "#/$defs/controlDescriptors"
				},
				"stream_port_input_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/streamPortDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"stream_port_output_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/streamPortDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"static",
				"stream_port_input_descriptors",
				"stream_port_output_descriptors"
			]
		},
		"audioUnitDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"clock_domain_index": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"sampling_rates": {
					"type": "array",
					"items": {
						"$ref": "../../common/2026.10.23/schema.json#/$defs/samplingRate"
					}
				},
				"control_counts": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				}
			},
			"required": [
				"localized_description",
				"clock_domain_index",
				"sampling_rates"
			]
		},
		"streamPortDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/streamPortDescriptorStaticModel"
				},
				"audio_cluster_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/audioClusterDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"audio_map_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/audioMapDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"control_descriptors": {
					"$ref": "#/$defs/controlDescriptors"
				}
			},
			"required": [
				"static",
				"audio_cluster_descriptors",
				"audio_map_descriptors"
			]
		},
		"streamPortDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"clock_domain_index": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"flags": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/portFlags"
				},
				"control_counts": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				}
			},
			"required": [
				"clock_domain_index",
				"flags"
			]
		},
		"audioClusterDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/audioClusterDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"audioClusterDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"signal_type": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/descriptorType"
				},
				"signal_index": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"signal_output": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				},
				"path_latency": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint32"
				},
				"block_latency": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint32"
				},
				"channel_count": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				},
				"format": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/audioClusterFormat"
				}
			},
			"required": [
				"localized_description",
				"signal_type",
				"signal_index",
				"signal_output",
				"path_latency",
				"block_latency",
				"channel_count",
				"format"
			]
		},
		"audioMapDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/audioMapDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"audioMapDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"mappings": {
					"type": "array",
					"items": {
						"$ref": "../../common/2026.10.23/schema.json#/$defs/audioMapping"
					}
				}
			},
			"required": [
				"mappings"
			]
		},
		"streamDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/streamDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"streamDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"clock_domain_index": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"stream_flags": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/streamFlags"
				},
				"backup_talker_entity_id_0": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uniqueIdentifier"
				},
				"backup_talker_unique_id_0": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				},
				"backup_talker_entity_id_1": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uniqueIdentifier"
				},
				"backup_talker_unique_id_1": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				},
				"backup_talker_entity_id_2": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uniqueIdentifier"
				},
				"backup_talker_unique_id_2": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				},
				"backedup_talker_entity_id": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uniqueIdentifier"
				},
				"backedup_talker_unique": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				},
				"avb_interface_index": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"buffer_length": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint32"
				},
				"formats": {
					"type": "array",
					"items": {
						"$ref": "../../common/2026.10.23/schema.json#/$defs/streamFormat"
					}
				},
				"redundant_streams": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/descriptorIndex"
					}
				}
			},
			"required": [
				"localized_description",
				"clock_domain_index",
				"stream_flags",
				"backup_talker_entity_id_0",
				"backup_talker_unique_id_0",
				"backup_talker_entity_id_1",
				"backup_talker_unique_id_1",
				"backup_talker_entity_id_2",
				"backup_talker_unique_id_2",
				"backedup_talker_entity_id",
				"backedup_talker_unique",
				"avb_interface_index",
				"buffer_length",
				"formats"
			]
		},
		"jackDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/jackDescriptorStaticModel"
				},
				"control_descriptors": {
					"$ref": "#/$defs/controlDescriptors"
				}
			},
			"required": [
				"static"
			]
		},
		"jackDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"flags": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/jackFlags"
				},
				"type": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/jackType"
				},
				"control_counts": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				}
			},
			"required": [
				"localized_description",
				"flags",
				"type"
			]
		},
		"avbInterfaceDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/avbInterfaceDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"avbInterfaceDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"flags": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/avbInterfaceFlags"
				},
				"port_number": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint16"
				}
			},
			"required": [
				"localized_description",
				"flags",
				"port_number"
			]
		},
		"clockSourceDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/clockSourceDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"clockSourceDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"clock_source_type": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/clockSourceType"
				},
				"clock_source_location_type": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/descriptorType"
				},
				"clock_source_location_index": {
					"$ref": "#/$defs/descriptorIndex"
				}
			},
			"required": [
				"localized_description",
				"clock_source_type",
				"clock_source_location_type",
				"clock_source_location_index"
			]
		},
		"memoryObjectDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/memoryObjectDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"memoryObjectDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"localized_description": {
					"$ref": "#/$defs/localizedDescription"
				},
				"memory_object_type": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/memoryObjectType"
				},
				"target_descriptor_type": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/descriptorType"
				},
				"target_descriptor_index": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"start_address": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{16}$"
				},
				"maximum_length": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/uint64"
				}
			},
			"required": [
				"localized_description",
				"memory_object_type",
				"target_descriptor_type",
				"target_descriptor_index",
				"start_address",
				"maximum_length"
			]
		},
		"localeDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/localeDescriptorStaticModel"
				},
				"strings_descriptors": {
					"oneOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/stringsDescriptor"
							}
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"static",
				"strings_descriptors"
			]
		},
		"localeDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"locale_id": {
					"$ref": "#/$defs/avdeccString"
				},
				"_base_string_descriptor (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				}
			},
			"required": [
				"locale_id"
			]
		},
		"stringsDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/stringsDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"stringsDescriptorStaticModel": {
			"type": "object",
			"properties": {
				"strings": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/avdeccString"
					},
					"maxItems": 7
				}
			},
			"required": [
				"strings"
			]
		},
		"controlDescriptors": {
			"oneOf": [
				{
					"type": "array",
					"items": {
						"$ref": "#/$defs/controlDescriptor"
					}
				},
				{
					"type": "null"
				}
			]
		},
		"controlDescriptor": {
			"type": "object",
			"properties": {
				"_index (informative)": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"static": {
					"$ref": "#/$defs/controlDescriptorStaticModel"
				}
			},
			"required": [
				"static"
			]
		},
		"controlNumber": {
			"$ref": "../../common/2026.10.23/schema.json#/$defs/controlNumber"
		},
		"controlValueUnit": {
			"type": "object",
			"properties": {
				"multiplier": {
					"type": "integer",
					"minimum": -128,
					"maximum": 127
				},
				"code": {
					"$ref": "../../common/2026.10.23/schema.json#/$defs/controlValueUnit"
				}
			},
			"required": [
				"multiplier",
				"code"
			]
		},
		"linearValueStatic": {
			"type": "object",
			"properties": {
				"minimum": {
					"$ref": "#/$defs/controlNumber"
				},
				"maximum": {
					"$ref": "#/$defs/controlNumber"
				},
				"step": {
					"$ref": "#/$defs/controlNumber"
				},
				"default": {
					"$ref": "#/$defs/controlNumber"
				},
				"unit": {
