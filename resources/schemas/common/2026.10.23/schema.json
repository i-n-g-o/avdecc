{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "AEM Common Definition",
	"description": "Common types and definitions used by the AEM, AVE and ANS schemas. A value not defined by the library (out of specification, or from a more recent specification) is serialized as the hexadecimal representation of its underlying value, so no information is lost.",
	"type": "object",
	"schema_version": "2026.10.23",
	"$defs": {
		"uniqueIdentifier": {
			"type": "string",
			"pattern": "^0x[0-9a-fA-F]{16}$",
			"description": "Defined as a string representing an hexadecimal 64 bits value."
		},
		"avdeccString": {
			"oneOf": [
				{
					"type": "string",
					"maxLength": 64
				},
				{
					"type": "array",
					"items": {
						"$ref": "#/$defs/uint8"
					},
					"maxItems": 64
				}
			],
			"description": "Defined as a string with a maximum length of 64 bytes (not characters, if possible in JSON Schema). If the string is not a valid UTF-8 string (cannot be represented as a JSON string), defined as an array of its bytes."
		},
		"descriptorIndex": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535,
			"description": "Defined as a number ranging from 0 to 65535."
		},
		"uint8": {
			"type": "integer",
			"minimum": 0,
			"maximum": 255,
			"description": "Defined as an unsigned one byte number (ranging from 0 to 255)."
		},
		"uint16": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535,
			"description": "Defined as an unsigned two bytes number (ranging from 0 to 65535)."
		},
		"uint32": {
			"type": "integer",
			"minimum": 0,
			"maximum": 4294967295,
			"description": "Defined as an unsigned four bytes number (ranging from 0 to 4294967295)."
		},
		"uint64": {
			"type": "integer",
			"minimum": 0,
			"maximum": 18446744073709551615,
			"description": "Defined as an unsigned 8 bytes number."
		},
		"int64": {
			"type": "integer",
			"minimum": -9223372036854775808,
			"maximum": 9223372036854775807,
			"description": "Defined as a signed 8 bytes number."
		},
		"hexValue8": {
			"type": "string",
			"pattern": "^0x[0-9a-fA-F]{1,2}$",
			"description": "Defined as a string representing an hexadecimal 8 bits value. Used for a value not defined by the library."
		},
		"hexValue16": {
			"type": "string",
			"pattern": "^0x[0-9a-fA-F]{1,4}$",
			"description": "Defined as a string representing an hexadecimal 16 bits value. Used for a value not defined by the library."
		},
		"hexValue32": {
			"type": "string",
			"pattern": "^0x[0-9a-fA-F]{1,8}$",
			"description": "Defined as a string representing an hexadecimal 32 bits value. Used for a value not defined by the library."
		},
		"controlNumber": {
			"oneOf": [
				{
					"type": "number"
				},
				{
					"type": "object",
					"properties": {
						"NaN": {
							"const": true
						},
						"Inf": {
							"const": true
						},
						"-Inf": {
							"const": true
						}
					},
					"minProperties": 1,
					"maxProperties": 1,
					"additionalProperties": false,
					"description": "Special floating point values"
				}
			],
			"description": "Defined as a number, or as an object for the special floating point values (NaN, infinity)."
		},
		"macAddress": {
			"type": "string",
			"pattern": "^([A-F0-9]{2}:){5}[A-F0-9]{2}$",
			"description": "Defined as a string representing 6 hexadecimal bytes separated by a colon."
		},
		"streamFormat": {
			"type": "string",
			"pattern": "^0x[0-9a-fA-F]{16}$",
			"description": "Defined as a string representing an hexadecimal 64 bits value."
		},
		"samplingRate": {
			"type": "string",
			"pattern": "^0x[0-9a-fA-F]{8}$",
			"description": "Defined as a string representing an hexadecimal 32 bits value."
		},
		"milanVersion": {
			"type": "string",
			"pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$",
			"description": "Defined as a string representing the 4 digits of the version separated by a dot."
		},
		"localizedDescription": {
			"type": "object",
			"properties": {
				"index": {
					"type": "integer",
					"minimum": 0,
					"maximum": 7
				},
				"offset": {
					"type": "integer",
					"minimum": 0,
					"maximum": 8191
				}
			},
			"required": [
				"index",
				"offset"
			],
			"description": "An object with the following properties of index (0-7) and offset (0-8191) all required"
		},
		"localizedDescriptionOrNull": {
			"oneOf": [
				{
					"$ref": "#/$defs/localizedDescription"
				},
				{
					"type": "null"
				}
			],
			"description": "A localizedDescription, or null if no localized string is referenced"
		},
		"audioMapping": {
			"type": "object",
			"properties": {
				"stream_index": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"stream_channel": {
					"$ref": "#/$defs/uint16"
				},
				"cluster_offset": {
					"$ref": "#/$defs/descriptorIndex"
				},
				"cluster_channel": {
					"$ref": "#/$defs/uint16"
				}
			},
			"required": [
				"stream_index",
				"stream_channel",
				"cluster_offset",
				"cluster_channel"
			],
			"description": "As an object with the following properties of StreamIndex (descriptor Index), stream Channel (uint16), cluster offset (descriptorIndex), and cluster channel (uint16) all required"
		},
		"msrpMapping": {
			"type": "object",
			"properties": {
				"traffic_class": {
					"$ref": "#/$defs/uint8"
				},
				"priority": {
					"$ref": "#/$defs/uint8"
				},
				"vlan_id": {
					"$ref": "#/$defs/uint16"
				}
			},
			"required": [
				"traffic_class",
				"priority",
				"vlan_id"
			]
		},
		"streamIdentification": {
			"type": "object",
			"properties": {
